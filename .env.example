# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# Comma-separated Telegram chat IDs that can trigger the pipeline
# Leave empty to allow any chat
TELEGRAM_ALLOWED_CHATS=

# Minimum relevance score (1-10) to process an article (default: 6)
RELEVANCE_THRESHOLD=6
